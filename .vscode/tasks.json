{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "main",
            "type": "shell",
            "command": "python -m src.main",
            "problemMatcher": [
                "$python"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test",
            "type": "shell",
            "command": "python -m test.test",
            "problemMatcher": [
                "$python"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}